STORE_API_URL=http://localhost:8000/api
STORE_ID=404
# Optional: <identifier>.<STORE_ROOT_DOMAIN> selects the store by subdomain; other hosts use STORE_ID.
STORE_ROOT_DOMAIN=
# Situs platform untuk tautan "Built with Sellosy" di footer.
PLATFORM_URL=https://sellosy.com
# Fallback when the store API does not return a registered theme.
# natural | minimal | boutique | editorial
STORE_THEME=natural
# Developer tema: "true" mengizinkan ?theme=<id> untuk pratinjau. Jangan diisi di produksi.
THEME_PREVIEW=
# Cache of public store API reads (store, theme/home, catalog, pages, menus), dropped instantly by
# the backend through POST /api/revalidate. Must equal STOREFRONT_REVALIDATE_SECRET in the Laravel
# .env (whose STOREFRONT_REVALIDATE_URL points at https://<storefront>/api/revalidate).
# Empty: nothing is cached and every page reads the API directly (local development).
REVALIDATE_SECRET=
# Fallback cache lifetime in seconds, in case a revalidation request is missed. Default 60.
STORE_CACHE_SECONDS=
# Same value as STOREFRONT_PROXY_SECRET in the Laravel .env. The API proxy then sends each buyer's IP,
# so backend rate limits (shipping rates, coupons, payment proof, ...) count buyers separately.
# Empty: the backend sees every guest as this server's IP, sharing one limit for the whole platform.
STOREFRONT_PROXY_SECRET=
# Header with the buyer's IP set by the outermost proxy, e.g. cf-connecting-ip behind Cloudflare
# (only when the server accepts traffic from Cloudflare alone). Empty: X-Real-IP, else the last
# X-Forwarded-For entry (written by Coolify's Traefik).
CLIENT_IP_HEADER=
