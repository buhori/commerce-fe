{
  "contract": 1,
  "id": "ambaz",
  "name": "Ambaz",
  "version": "1.0.0",
  "description": "Toko modern multiguna: slider besar, kartu produk dengan aksi cepat, banner promosi, dan koleksi pilihan.",
  "settings": [],
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "name": "Bilah pengumuman",
      "templates": [
        "header"
      ],
      "settings": [
        {
          "id": "background",
          "type": "color",
          "label": "Warna latar",
          "default": "#000000"
        },
        {
          "id": "text_color",
          "type": "color",
          "label": "Warna teks",
          "default": "#ffffff"
        },
        {
          "id": "autoplay",
          "type": "checkbox",
          "label": "Ganti pengumuman otomatis setiap 5 detik",
          "default": false
        },
        {
          "id": "show_contact",
          "type": "checkbox",
          "label": "Tampilkan telepon dan email toko di kanan",
          "default": true
        },
        {
          "type": "heading",
          "content": "Media sosial (kiri)"
        },
        {
          "id": "twitter",
          "type": "link",
          "label": "X (Twitter)",
          "default": null
        },
        {
          "id": "facebook",
          "type": "link",
          "label": "Facebook",
          "default": null
        },
        {
          "id": "instagram",
          "type": "link",
          "label": "Instagram",
          "default": null
        },
        {
          "id": "tiktok",
          "type": "link",
          "label": "TikTok",
          "default": null
        },
        {
          "id": "linkedin",
          "type": "link",
          "label": "LinkedIn",
          "default": null
        }
      ],
      "blocks": {
        "announcement": {
          "name": "Pengumuman",
          "max": 6,
          "settings": [
            {
              "id": "text",
              "type": "text",
              "label": "Teks",
              "maxLength": 80
            },
            {
              "id": "link",
              "type": "link",
              "label": "Tautan",
              "default": null
            }
          ]
        }
      },
      "default": {
        "blocks": [
          {
            "type": "announcement",
            "settings": {
              "text": "Welcome to our store →"
            }
          },
          {
            "type": "announcement",
            "settings": {
              "text": "Free shipping on orders over $150 →"
            }
          },
          {
            "type": "announcement",
            "settings": {
              "text": "New arrivals just dropped →",
              "link": "/products"
            }
          }
        ]
      }
    },
    "main-header": {
      "type": "main-header",
      "name": "Header",
      "templates": [
        "header"
      ],
      "settings": [
        {
          "id": "logo",
          "type": "image",
          "label": "Logo",
          "info": "Kosongkan untuk memakai logo toko.",
          "default": null,
          "accept": [
            "png",
            "webp",
            "jpg"
          ],
          "recommended": "260 × 72"
        },
        {
          "id": "logo_width",
          "type": "range",
          "label": "Lebar logo",
          "default": 130,
          "min": 80,
          "max": 240,
          "step": 5,
          "unit": "px"
        },
        {
          "id": "sticky",
          "type": "checkbox",
          "label": "Header tetap di atas saat digulir",
          "default": true
        },
        {
          "id": "show_wishlist",
          "type": "checkbox",
          "label": "Tampilkan wishlist",
          "default": true
        },
        {
          "type": "paragraph",
          "content": "Menu diambil dari Navigasi toko; sub-menu tampil sebagai dropdown."
        },
        {
          "type": "heading",
          "content": "Panel pencarian"
        },
        {
          "id": "search_placeholder",
          "type": "text",
          "label": "Teks kolom cari",
          "default": "What are you looking for...",
          "maxLength": 60
        },
        {
          "id": "popular_title",
          "type": "text",
          "label": "Judul pencarian populer",
          "default": "Popular searches:",
          "maxLength": 40
        },
        {
          "id": "popular_searches",
          "type": "text",
          "label": "Pencarian populer",
          "info": "Pisahkan dengan koma.",
          "default": "T-Shirt, Blue, Jacket, Dress, Shorts",
          "maxLength": 200
        },
        {
          "id": "products_title",
          "type": "text",
          "label": "Judul produk",
          "default": "Most searched products:",
          "maxLength": 40
        },
        {
          "id": "products",
          "type": "product-source",
          "label": "Produk di panel pencarian",
          "default": {
            "source": "top_sale",
            "limit": 4
          },
          "max": 8
        },
        {
          "type": "heading",
          "content": "Mega menu"
        },
        {
          "type": "paragraph",
          "content": "Otomatis: menu yang sub-menunya punya tautan tingkat ketiga tampil sebagai kolom; sub-menu kategori bergambar tampil sebagai kartu. Tambah block Mega menu untuk gambar promo atau memaksa tata letak."
        }
      ],
      "blocks": {
        "mega": {
          "name": "Mega menu",
          "max": 8,
          "settings": [
            {
              "id": "menu",
              "type": "text",
              "label": "Item menu",
              "info": "Nama item menu utama persis seperti di Navigasi, mis. Shop.",
              "maxLength": 60
            },
            {
              "id": "layout",
              "type": "select",
              "label": "Tata letak",
              "default": "auto",
              "options": [
                {
                  "value": "auto",
                  "label": "Otomatis"
                },
                {
                  "value": "columns",
                  "label": "Kolom tautan"
                },
                {
                  "value": "cards",
                  "label": "Kartu kategori"
                },
                {
                  "value": "dropdown",
                  "label": "Dropdown biasa"
                }
              ]
            },
            {
              "id": "cards",
              "type": "range",
              "label": "Jumlah kartu kategori",
              "default": 5,
              "min": 3,
              "max": 6,
              "visibleIf": {
                "setting": "layout",
                "equals": "cards"
              }
            },
            {
              "type": "heading",
              "content": "Gambar promo (tata letak kolom)"
            },
            {
              "id": "image",
              "type": "image",
              "label": "Gambar",
              "default": null,
              "accept": [
                "jpg",
                "png",
                "webp"
              ],
              "recommended": "540 × 540"
            },
            {
              "id": "title",
              "type": "text",
              "label": "Judul",
              "maxLength": 40
            },
            {
              "id": "subtitle",
              "type": "text",
              "label": "Keterangan",
              "default": "SHOP NOW",
              "maxLength": 40
            },
            {
              "id": "link",
              "type": "link",
              "label": "Tautan",
              "default": null
            }
          ]
        }
      }
    },
